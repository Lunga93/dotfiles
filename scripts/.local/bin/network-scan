#!/usr/bin/env bash
set -euo pipefail

# network-scan
# One-shot scan of available wifi networks. Emits JSON.
# SSIDs are JSON-escaped via jq (never string-interpolated), and terse nmcli
# output is parsed from the right so SSIDs containing ':' survive.

JQ="$(command -v jq || true)"
NMCLI="$(command -v nmcli || true)"

fail() {
    echo "{\"wifi_hw\":false,\"wifi_enabled\":false,\"error\":\"$1\",\"networks\":[]}"
    exit 1
}

[ -n "$NMCLI" ] || fail "nmcli not found"
[ -n "$JQ" ] || fail "jq not found"

radio=$("$NMCLI" radio wifi 2>/dev/null || true)
[ "$radio" = "enabled" ] && wifi_enabled=true || wifi_enabled=false

# Hardware present == a wifi device is visible to the daemon (driver bound).
# The radio may still be off; that is reported separately via wifi_enabled.
wifi_hw=false
if "$NMCLI" -t -f TYPE device status 2>/dev/null | grep -qx 'wifi'; then
    wifi_hw=true
fi

if [ "$wifi_hw" != "true" ] || [ "$wifi_enabled" != "true" ]; then
    echo "{\"wifi_hw\":$wifi_hw,\"wifi_enabled\":$wifi_enabled,\"error\":\"\",\"networks\":[]}"
    exit 0
fi

# Request a fresh scan
"$NMCLI" device wifi list --rescan yes >/dev/null 2>&1 || true

# Parse terse output. Fields are ':'-separated (SSID:SIGNAL:SECURITY), but an
# SSID may itself contain ':' — so split from the right: security is the last
# field, signal the second-last, everything before is the SSID. Dedup by SSID
# (case-insensitive), keep the strongest signal. Emit tab-separated lines so
# jq can JSON-escape the SSID safely.
list=$("$NMCLI" -t -e no -f SSID,SIGNAL,SECURITY device wifi list 2>/dev/null | awk -F: '
    {
        ssid = ""; signal = ""; sec = ""
        n = NF
        if (n >= 3) { sec = $n; signal = $(n-1); ssid = $1; for (i = 2; i <= n-2; i++) ssid = ssid ":" $i }
        else if (n == 2) { signal = $2; ssid = $1 }
        else if (n == 1) { ssid = $1 }
        if (ssid == "" || ssid == "--") next
        key = tolower(ssid)
        if (key in max) {
            if (signal + 0 > max[key] + 0) { max[key] = signal; secs[key] = sec }
        } else {
            max[key] = signal; secs[key] = sec; keys[++k] = key; names[key] = ssid
        }
    }
    END {
        for (i = 1; i <= k; i++) {
            s = names[keys[i]]
            is_sec = (secs[keys[i]] != "" && secs[keys[i]] != "--") ? "true" : "false"
            printf "%s\t%d\t%s\n", s, max[keys[i]] + 0, is_sec
        }
    }')

networks=$(
    printf '%s\n' "$list" |
    jq -Rsc '
        split("\n") |
        map(select(length > 0)) |
        map(
            split("\t") |
            (.[1] | tonumber) as $sig |
            { ssid: .[0],
              signal: $sig,
              bars: ((if $sig <= 0 then 0 else (($sig / 25) | floor) + 1 end) | if . > 4 then 4 else . end),
              secured: (.[2] == "true") }
        )'
)

echo "{\"wifi_hw\":true,\"wifi_enabled\":$wifi_enabled,\"error\":\"\",\"networks\":$networks}"
