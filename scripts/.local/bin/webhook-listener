#!/usr/bin/env python3
"""Webhook listener for the self-healing Niri desktop pipeline.

Receives error payloads from the journal watcher, maps them to
dotfiles packages, invokes OpenCode in headless mode to apply a fix,
and auto-commits successful fixes to a branch.
"""

import http.server
import json
import os
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlparse

STATE_DIR = Path.home() / ".local" / "state" / "niri-heal"
LOG_FILE = STATE_DIR / "heal.log"
PORT = 9876
OPENCODE_TIMEOUT = 300

UNIT_TO_PACKAGE = {
    "niri.service":     "niri",
    "swaync.service":   "swaync",
    "quickshell":       "quickshell",
    "qs":               "quickshell",
}

DOTFILES_ROOT = Path.home() / "dotfiles"
RATE_LIMIT_SECONDS = 300

_last_trigger: dict[str, float] = {}


def log(status: str, detail: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(LOG_FILE, "a") as f:
        f.write(f"[{ts}] {status}: {detail}\n")


def rate_limited(unit: str) -> bool:
    now = time.time()
    last = _last_trigger.get(unit, 0)
    if now - last < RATE_LIMIT_SECONDS:
        return True
    _last_trigger[unit] = now
    return False


def notify(msg: str, urgent: bool = False) -> None:
    args = ["notify-send", "-a", "niri-heal", "🩺 Niri Healer", msg]
    if urgent:
        args.insert(1, "-u")
        args.insert(2, "critical")
    subprocess.run(args, capture_output=True)


def run_opencode(unit: str, pkg: str, message: str) -> int:
    prompt = (
        f"A critical error was detected in {unit} (stow package: '{pkg}').\n\n"
        f"Error message:\n```\n{message[:2000]}\n```\n\n"
        f"The dotfiles repository is at {DOTFILES_ROOT}. "
        f"Each top-level directory is a GNU Stow package — "
        f"its internal layout mirrors the install destination.\n\n"
        f"Your job:\n"
        f"1. Identify the root cause of this error in the '{pkg}' package config files.\n"
        f"2. Create a .bak backup of each file before editing it.\n"
        f"3. Apply the minimal fix needed to resolve the error.\n"
        f"4. Restart the service: `systemctl --user restart {unit}`\n"
        f"5. If the fix involves generated/template files, edit the template, "
        f"not the generated file.\n\n"
        f"Return a one-line summary of what you changed."
    )
    env = os.environ.copy()
    env.setdefault("HOME", str(Path.home()))
    result = subprocess.run(
        ["opencode", "run", prompt],
        capture_output=True,
        text=True,
        timeout=OPENCODE_TIMEOUT,
        cwd=DOTFILES_ROOT,
        env=env,
    )
    if result.returncode != 0:
        log("OPENCODE_FAIL", f"exit={result.returncode} stderr={result.stderr[-500:]}")
    return result.returncode


def try_commit(pkg: str, unit: str, error_snippet: str) -> None:
    ts = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    branch = f"autoheal/{pkg}-{ts}"

    subprocess.run(["git", "checkout", "-b", branch], cwd=DOTFILES_ROOT, capture_output=True)
    subprocess.run(["git", "add", "-A"], cwd=DOTFILES_ROOT, capture_output=True)

    diff = subprocess.run(
        ["git", "diff", "--cached", "--stat"],
        cwd=DOTFILES_ROOT, capture_output=True, text=True
    )
    if not diff.stdout.strip():
        log("SKIPPED", f"no changes to commit for {unit}")
        subprocess.run(["git", "checkout", "main"], cwd=DOTFILES_ROOT, capture_output=True)
        return

    summary = error_snippet[:80].replace("\n", " ")
    msg = f"fix({pkg}): auto-heal {summary}"
    subprocess.run(
        ["git", "commit", "-m", msg],
        cwd=DOTFILES_ROOT, capture_output=True,
    )

    push = subprocess.run(
        ["git", "push", "origin", branch],
        cwd=DOTFILES_ROOT, capture_output=True, text=True,
    )
    if push.returncode == 0:
        log("COMMITTED", f"branch={branch} message={msg}")
        notify(f"Auto-fix committed to branch '{branch}'. Review and merge when ready.", urgent=True)
    else:
        log("PUSH_FAIL", f"branch={branch} stderr={push.stderr[-300:]}")
        notify(f"Fix applied locally on '{branch}' but push failed. Check logs.")


class HealHandler(http.server.BaseHTTPRequestHandler):
    def do_POST(self) -> None:
        if urlparse(self.path).path != "/heal":
            self.send_error(404)
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
            body = self.rfile.read(length)
            payload = json.loads(body)
        except (json.JSONDecodeError, ValueError):
            self.send_error(400, "Invalid JSON")
            return

        unit = payload.get("unit", "unknown")
        message = payload.get("message", "")
        priority = payload.get("priority", "")

        if not message.strip():
            self.send_error(400, "Missing 'message' field")
            return

        if rate_limited(unit):
            log("RATE_LIMITED", unit)
            self._respond({"status": "rate_limited"})
            return

        pkg = UNIT_TO_PACKAGE.get(unit, "unknown")
        log("RECEIVED", f"unit={unit} pkg={pkg} prio={priority} msg={message[:120]}")

        notify(f"Error in {unit} — analyzing...")

        rc = run_opencode(unit, pkg, message)
        if rc == 0:
            log("FIXED", f"unit={unit}")
            try_commit(pkg, unit, message)
            self._respond({"status": "fixed", "unit": unit, "package": pkg})
        else:
            log("FAILED", f"unit={unit} exit={rc}")
            notify(f"Could not auto-fix {unit}. See ~/.local/state/niri-heal/heal.log", urgent=True)
            self._respond({"status": "failed", "unit": unit, "exit_code": rc})

    def _respond(self, payload: dict) -> None:
        data = json.dumps(payload).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, fmt: str, *args: object) -> None:
        log("HTTP", fmt % args)


def main() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log("START", f"listening on 127.0.0.1:{PORT}/heal")
    server = http.server.HTTPServer(("127.0.0.1", PORT), HealHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log("STOP", "shutting down")
        server.shutdown()


if __name__ == "__main__":
    main()
