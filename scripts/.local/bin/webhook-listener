#!/usr/bin/env python3
"""Webhook listener for the self-healing Niri desktop pipeline.

Receives error payloads from the journal watcher, maps them to
dotfiles packages, invokes OpenCode in headless mode to apply a fix,
and auto-commits successful fixes to a branch.

Endpoints:
  POST /heal   — error fixing (journal watcher)
  POST /task   — feature development (manual dev loop)

Pause guard: create ~/.local/state/niri-heal/pause to skip all processing.
Remove it to resume.
"""

import http.server
import json
import os
import subprocess
import threading
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlparse

STATE_DIR = Path.home() / ".local" / "state" / "niri-heal"
TASK_DIR = STATE_DIR / "tasks"
PAUSE_FILE = STATE_DIR / "pause"
LOG_FILE = STATE_DIR / "heal.log"
PORT = 9876
OPENCODE_TIMEOUT = 900

UNIT_TO_PACKAGE = {
    "niri.service":     "niri",
    "swaync.service":   "swaync",
    "quickshell":       "quickshell",
    "qs":               "quickshell",
}

DOTFILES_ROOT = Path.home() / "dotfiles"
RATE_LIMIT_SECONDS = 300

_last_trigger: dict[str, float] = {}


def log(status: str, detail: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(LOG_FILE, "a") as f:
        f.write(f"[{ts}] {status}: {detail}\n")


def is_paused() -> bool:
    return PAUSE_FILE.exists()


def rate_limited(key: str) -> bool:
    now = time.time()
    last = _last_trigger.get(key, 0)
    if now - last < RATE_LIMIT_SECONDS:
        return True
    _last_trigger[key] = now
    return False


def notify(msg: str, urgent: bool = False) -> None:
    args = ["notify-send", "-a", "niri-heal", "Niri Healer", msg]
    if urgent:
        args.insert(1, "-u")
        args.insert(2, "critical")
    subprocess.run(args, capture_output=True)


def _dirty_snapshot() -> set[str]:
    result = subprocess.run(
        ["git", "diff", "--name-only"],
        cwd=DOTFILES_ROOT, capture_output=True, text=True,
    )
    untracked = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard"],
        cwd=DOTFILES_ROOT, capture_output=True, text=True,
    )
    dirty: set[str] = set()
    if result.returncode == 0:
        dirty.update(p.strip() for p in result.stdout.splitlines() if p.strip())
    if untracked.returncode == 0:
        dirty.update(p.strip() for p in untracked.stdout.splitlines() if p.strip())
    return dirty


def _run_opencode_streaming(prompt: str, label: str, log_path: str | None = None) -> int:
    """Run opencode and stream output to a per-task log file in real-time."""
    TASK_DIR.mkdir(parents=True, exist_ok=True)
    ts = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    safe_label = "".join(c if c.isalnum() or c in "-_" else "_" for c in label)[:40]
    if log_path is None:
        log_path = str(TASK_DIR / f"{ts}-{safe_label}.log")
    task_log = Path(log_path)

    env = os.environ.copy()
    env.setdefault("HOME", str(Path.home()))

    with open(task_log, "w") as f:
        f.write(f"# Task: {label}\n")
        f.write(f"# Started: {datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}\n")
        f.write(f"# Log: tail -f {task_log}\n")
        f.write("#" + "=" * 60 + "\n\n")

        f.flush()
        proc = subprocess.Popen(
            ["opencode", "run", prompt],
            stdout=f, stderr=subprocess.STDOUT,
            text=True,
            cwd=DOTFILES_ROOT,
            env=env,
        )
        try:
            proc.wait(timeout=OPENCODE_TIMEOUT)
        except subprocess.TimeoutExpired:
            proc.kill()
            f.write(f"\n\n# TIMEOUT after {OPENCODE_TIMEOUT}s\n")
            log("OPENCODE_TIMEOUT", label)
            return 1
        rc = proc.returncode
        f.write(f"\n\n# Exit code: {rc}\n")
        f.write(f"# Finished: {datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}\n")

    log("TASK_LOG", f"{task_log} exit={rc}")
    return rc


def run_opencode_heal(unit: str, pkg: str, message: str, log_path: str | None = None) -> int:
    prompt = (
        f"A critical error was detected in {unit} (stow package: '{pkg}').\n\n"
        f"Error message:\n```\n{message[:2000]}\n```\n\n"
        f"The dotfiles repository is at {DOTFILES_ROOT}. "
        f"Each top-level directory is a GNU Stow package — "
        f"its internal layout mirrors the install destination.\n\n"
        f"Your job:\n"
        f"1. Identify the root cause of this error in the '{pkg}' package config files.\n"
        f"2. Create a .bak backup of each file before editing it.\n"
        f"3. Apply the minimal fix needed to resolve the error.\n"
        f"4. Restart the service: `systemctl --user restart {unit}`\n"
        f"5. If the fix involves generated/template files, edit the template, "
        f"not the generated file.\n\n"
        f"Return a one-line summary of what you changed."
    )
    return _run_opencode_streaming(prompt, f"heal-{unit}", log_path)


def run_opencode_task(message: str, log_path: str | None = None) -> int:
    prompt = (
        f"Implement the following feature in the Manatee Desktop dotfiles "
        f"repository at {DOTFILES_ROOT}.\n\n"
        f"Task:\n```\n{message[:2000]}\n```\n\n"
        f"Context: This is a Niri Wayland desktop for Arch (CachyOS). "
        f"Configs are GNU Stow packages — each top-level directory mirrors "
        f"its install destination. See the package layout:\n"
        f"  niri/       → ~/.config/niri/           (KDL config)\n"
        f"  quickshell/ → ~/.config/quickshell/     (QML bar + panels)\n"
        f"  swaync/     → ~/.config/swaync/         (JSON + CSS)\n"
        f"  alacritty/  → ~/.config/alacritty/      (TOML)\n"
        f"  wofi/       → ~/.config/wofi/           (INI + CSS)\n"
        f"  gtk/        → ~/.config/gtk-{3,4}.0/    (CSS)\n"
        f"  scripts/    → ~/.local/bin/             (Bash)\n"
        f"  systemd/    → ~/.config/systemd/user/   (unit files)\n"
        f"  opencode/   → ~/.config/opencode/       (agent config)\n\n"
        f"Rules:\n"
        f"1. Follow existing code conventions (shell: 4-space, KDL: 4-space, "
        f"QML: 4-space, JSON: 2-space, TOML: 2-space, CSS: 2-space).\n"
        f"2. Create .bak backups before editing files.\n"
        f"3. Never edit generated files (swaync/colors.css, wofi/colors-wal.css, "
        f"gtk/colors-wal.css). Edit templates instead.\n"
        f"4. Never hardcode colors in QML — use Theme.qml tokens.\n"
        f"5. After making changes, stow the package: `stow -R <pkg>`\n"
        f"6. Restart affected services if needed.\n"
        f"7. Return a one-line summary of what you implemented."
    )
    return _run_opencode_streaming(prompt, f"task-{message[:30].strip()}", log_path)


def try_commit(pkg: str, label: str, snippet: str, pre_dirty: set[str],
               branch_prefix: str = "autoheal") -> None:
    ts = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    branch = f"{branch_prefix}/{pkg}-{ts}"

    new_diff = subprocess.run(
        ["git", "diff", "--name-only"],
        cwd=DOTFILES_ROOT, capture_output=True, text=True,
    )
    new_untracked = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard"],
        cwd=DOTFILES_ROOT, capture_output=True, text=True,
    )
    changed: set[str] = set()
    if new_diff.returncode == 0:
        changed.update(p.strip() for p in new_diff.stdout.splitlines() if p.strip())
    if new_untracked.returncode == 0:
        changed.update(p.strip() for p in new_untracked.stdout.splitlines() if p.strip())

    healed = changed - pre_dirty
    if not healed:
        log("SKIPPED", f"no changes detected for {label}")
        return

    log("CHANGES", f"files={list(healed)}")

    subprocess.run(["git", "checkout", "-b", branch], cwd=DOTFILES_ROOT, capture_output=True)
    for f in sorted(healed):
        subprocess.run(["git", "add", f], cwd=DOTFILES_ROOT, capture_output=True)

    summary = snippet[:80].replace("\n", " ")
    prefix = "fix" if branch_prefix == "autoheal" else "feat"
    msg = f"{prefix}({pkg}): {summary}"
    subprocess.run(
        ["git", "commit", "-m", msg],
        cwd=DOTFILES_ROOT, capture_output=True,
    )

    push = subprocess.run(
        ["git", "push", "origin", branch],
        cwd=DOTFILES_ROOT, capture_output=True, text=True,
    )
    if push.returncode == 0:
        log("COMMITTED", f"branch={branch} files={list(healed)}")
        notify(f"Committed to branch '{branch}'. Review and merge when ready.", urgent=True)
    else:
        log("PUSH_FAIL", f"branch={branch} stderr={push.stderr[-300:]}")
        notify(f"Changes on '{branch}' but push failed. Check logs.", urgent=True)


class HealHandler(http.server.BaseHTTPRequestHandler):
    def _task_log_path(self, label: str) -> str:
        ts = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
        safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in label)[:40]
        return str(TASK_DIR / f"{ts}-{safe}.log")
    def do_POST(self) -> None:
        path = urlparse(self.path).path
        if path == "/heal":
            self._handle_heal()
        elif path == "/task":
            self._handle_task()
        else:
            self.send_error(404)

    def _handle_heal(self) -> None:
        try:
            length = int(self.headers.get("Content-Length", "0"))
            payload = json.loads(self.rfile.read(length))
        except (json.JSONDecodeError, ValueError):
            self.send_error(400, "Invalid JSON")
            return

        unit = payload.get("unit", "unknown")
        message = payload.get("message", "")
        priority = payload.get("priority", "")

        if not message.strip():
            self.send_error(400, "Missing 'message' field")
            return

        if is_paused():
            log("PAUSED", f"unit={unit} (pause file exists)")
            self._respond({"status": "paused"})
            return

        if rate_limited(unit):
            log("RATE_LIMITED", unit)
            self._respond({"status": "rate_limited"})
            return

        pkg = UNIT_TO_PACKAGE.get(unit, "unknown")
        log("RECEIVED", f"unit={unit} pkg={pkg} prio={priority} msg={message[:120]}")
        log_path = self._task_log_path(f"heal-{unit}")

        self._respond({"status": "accepted", "unit": unit, "package": pkg,
                       "log": f"tail -f {log_path}"})

        notify(f"Error in {unit} — analyzing...\ntail -f {log_path}")
        pre_dirty = _dirty_snapshot()

        def heal_bg() -> None:
            try:
                rc = run_opencode_heal(unit, pkg, message, log_path)
                if rc == 0:
                    log("FIXED", f"unit={unit}")
                    try_commit(pkg, unit, message, pre_dirty)
                else:
                    log("FAILED", f"unit={unit} exit={rc}")
                    notify(f"Could not auto-fix {unit}. See heal.log", urgent=True)
            except Exception as exc:
                log("EXCEPTION", f"unit={unit} {exc}")
                notify(f"Heal pipeline failed for {unit}: {exc}", urgent=True)

        threading.Thread(target=heal_bg, daemon=True).start()

    def _handle_task(self) -> None:
        try:
            length = int(self.headers.get("Content-Length", "0"))
            payload = json.loads(self.rfile.read(length))
        except (json.JSONDecodeError, ValueError):
            self.send_error(400, "Invalid JSON")
            return

        message = payload.get("message", "")
        pkg = payload.get("package", "")

        if not message.strip():
            self.send_error(400, "Missing 'message' field")
            return

        if is_paused():
            log("PAUSED", f"task (pause file exists)")
            self._respond({"status": "paused"})
            return

        task_id = pkg or "dotfiles"
        if rate_limited(f"task:{task_id}"):
            log("RATE_LIMITED", f"task:{task_id}")
            self._respond({"status": "rate_limited"})
            return

        log("TASK_RECEIVED", f"pkg={pkg or 'auto'} msg={message[:120]}")
        log_path = self._task_log_path(f"task-{message[:30].strip()}")

        self._respond({"status": "accepted", "package": pkg or "auto",
                       "log": f"tail -f {log_path}"})

        notify(f"Working on: {message[:80]}...\ntail -f {log_path}")
        pre_dirty = _dirty_snapshot()

        def task_bg() -> None:
            try:
                rc = run_opencode_task(message, log_path)
                if rc == 0:
                    log("TASK_DONE", f"pkg={pkg or 'auto'}")
                    try_commit(pkg or "dotfiles", message, message, pre_dirty,
                               branch_prefix="feature")
                    notify(f"Feature complete: {message[:60]}...")
                else:
                    log("TASK_FAILED", f"pkg={pkg or 'auto'} exit={rc}")
                    notify(f"Task failed: {message[:60]}...", urgent=True)
            except Exception as exc:
                log("TASK_EXCEPTION", f"{exc}")
                notify(f"Task pipeline failed: {exc}", urgent=True)

        threading.Thread(target=task_bg, daemon=True).start()

    def _respond(self, payload: dict) -> None:
        data = json.dumps(payload).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, fmt: str, *args: object) -> None:
        log("HTTP", fmt % args)


def main() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    TASK_DIR.mkdir(parents=True, exist_ok=True)
    log("START", f"listening on 127.0.0.1:{PORT} [/heal, /task]")
    server = http.server.HTTPServer(("127.0.0.1", PORT), HealHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log("STOP", "shutting down")
        server.shutdown()


if __name__ == "__main__":
    main()
