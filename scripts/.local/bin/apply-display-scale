#!/usr/bin/env bash
set -euo pipefail

# apply-display-scale
# Reads display.scale from ~/.config/dotfiles/settings.json and applies:
#   - GTK: gsettings text-scaling-factor
#   - Qt:  writes QT_SCALE_FACTOR to ~/.config/environment.d/scale.conf
#          (takes effect on next session start)

SETTINGS="$HOME/.config/dotfiles/settings.json"
ENV_DIR="$HOME/.config/environment.d"
ENV_FILE="$ENV_DIR/scale.conf"

JQ="/usr/bin/jq"
command -v jq >/dev/null 2>&1 && JQ="$(command -v jq)"

get_scale() {
    if [ -x "$JQ" ] && [ -f "$SETTINGS" ]; then
        "$JQ" -r '.display.scale // 1.0' "$SETTINGS" 2>/dev/null || echo "1.0"
    else
        echo "1.0"
    fi
}

scale="$(get_scale)"

# GTK: gsettings text-scaling-factor
gsettings set org.gnome.desktop.interface text-scaling-factor "$scale"

# Qt: write environment.d snippet for next session
mkdir -p "$ENV_DIR"
cat > "$ENV_FILE" <<EOF
# Generated by apply-display-scale — do not edit by hand.
QT_SCALE_FACTOR=$scale
EOF
