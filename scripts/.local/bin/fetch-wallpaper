#!/usr/bin/env bash
set -euo pipefail

# fetch-wallpaper
# Downloads a random wallpaper using Unsplash and triggers set-wallpaper

CONFIG_DIR="$HOME/.config/dotfiles"
OUT_DIR="$HOME/Pictures/wallpapers"
OUT_FILE="$OUT_DIR/daily.jpg"
OUT_TMP="$OUT_DIR/daily.tmp"

mkdir -p "$OUT_DIR"

# Helper to validate downloaded image
validate_image() {
    if [ ! -s "$OUT_TMP" ]; then return 1; fi
    # Check if file command identifies it as image
    if ! file --mime-type "$OUT_TMP" | grep -q "image/"; then
        echo "Error: Downloaded file is not a valid image (detected: $(file -b --mime-type "$OUT_TMP"))." >&2
        rm -f "$OUT_TMP"
        return 1
    fi
    return 0
}

# Priority order for wallpaper source:
# 1) If $LOCAL_WALLPAPER_DIR is set and contains files, pick a random local file
# 2) If UNSPLASH_API_KEY exists at $CONFIG_DIR/unsplash_api_key use Unsplash
# 3) If WALLHAVEN_API_KEY exists at $CONFIG_DIR/wallhaven_api_key use Wallhaven
# 4) If PEXELS_API_KEY exists at $CONFIG_DIR/pexels_api_key use Pexels
# 5) Fallback to Bing Photo of the Day
# 6) Fallback to Lorem Picsum (no API key required)

CONFIG_FILE="$CONFIG_DIR/settings.json"
LIBRARY_DIR=""
if [ -f "$CONFIG_FILE" ]; then
    LIBRARY_DIR=$(jq -r '.wallpaper.library_dir // empty' "$CONFIG_FILE" 2>/dev/null || true)
fi
LOCAL_WALLPAPER_DIR="${LIBRARY_DIR:-$HOME/Pictures/wallpapers}"
UNSPLASH_KEY_FILE="$CONFIG_DIR/unsplash_api_key"
WALLHAVEN_KEY_FILE="$CONFIG_DIR/wallhaven_api_key"
PEXELS_KEY_FILE="$CONFIG_DIR/pexels_api_key"

choose_local() {
    if [ -d "$LOCAL_WALLPAPER_DIR" ]; then
        # find images and pick one randomly
        mapfile -t files < <(find "$LOCAL_WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) )
        if [ "${#files[@]}" -gt 0 ]; then
            # pick random
            idx=$((RANDOM % ${#files[@]}))
            echo "${files[$idx]}"
            return 0
        fi
    fi
    return 1
}

USER_AGENT="manatee-desktop/1.0"

download_wallhaven() {
    local apikey="$1"
    local size="${WALLPAPER_SIZE:-1920x1080}"
    local queries=("anime landscape" "digital art" "minimal" "nature" "abstract" "space" "city" "cyberpunk" "fantasy" "mountain" "ocean")
    local query=${queries[$RANDOM % ${#queries[@]}]}

    echo "Fetching from Wallhaven (query: $query)..."
    local API_URL="https://wallhaven.cc/api/v1/search?q=$(python3 -c "import urllib.parse; print(urllib.parse.quote('$query'))")&categories=111&purity=110&sorting=toplist&page=1&apikey=$apikey"
    local JSON
    JSON=$(curl -fsSL "$API_URL") || return 1
    local COUNT
    COUNT=$(echo "$JSON" | jq '.data | length' 2>/dev/null || echo 0)
    if [ "$COUNT" -eq 0 ]; then
        return 1
    fi
    local idx=$((RANDOM % COUNT))
    local IMG_URL
    IMG_URL=$(echo "$JSON" | jq -r ".data[$idx].path" 2>/dev/null)
    if [ -z "$IMG_URL" ] || [ "$IMG_URL" = "null" ]; then
        return 1
    fi
    echo "Downloading from Wallhaven..."
    curl -fsSL -A "$USER_AGENT" -o "$OUT_TMP" "$IMG_URL" || return 1
    validate_image || return 1
}

download_pexels() {
    local apikey="$1"
    local queries=("nature" "city" "minimal" "abstract" "mountain" "ocean" "night sky" "architecture" "sunset")
    local query=${queries[$RANDOM % ${#queries[@]}]}

    echo "Fetching from Pexels (query: $query)..."
    local JSON
    JSON=$(curl -fsSL -H "Authorization: $apikey" \
        "https://api.pexels.com/v1/search?query=$(python3 -c "import urllib.parse; print(urllib.parse.quote('$query'))")&per_page=15&orientation=landscape&size=large") || return 1
    local COUNT
    COUNT=$(echo "$JSON" | jq '.photos | length' 2>/dev/null || echo 0)
    if [ "$COUNT" -eq 0 ]; then
        return 1
    fi
    local idx=$((RANDOM % COUNT))
    local IMG_URL
    IMG_URL=$(echo "$JSON" | jq -r ".photos[$idx].src.original // .photos[$idx].src.large2x // .photos[$idx].src.large" 2>/dev/null)
    if [ -z "$IMG_URL" ] || [ "$IMG_URL" = "null" ]; then
        return 1
    fi
    echo "Downloading from Pexels..."
    curl -fsSL -A "$USER_AGENT" -o "$OUT_TMP" "$IMG_URL" || return 1
    validate_image || return 1
}

download_bing() {
    echo "Fetching Photo of the Day from Bing..."
    # Randomize index between 0 (today) and 7 (a week ago)
    IDX=$((RANDOM % 8))

    # Fetch JSON
    JSON=$(curl -sSL "https://www.bing.com/HPImageArchive.aspx?format=js&idx=$IDX&n=1&mkt=en-US") || return 1

    # Extract relative URL
    REL_URL=$(echo "$JSON" | jq -r '.images[0].url')
    if [ -z "$REL_URL" ] || [ "$REL_URL" = "null" ]; then
        return 1
    fi

    FULL_URL="https://www.bing.com${REL_URL}"
    echo "Downloading image from Bing ($FULL_URL)..."
    curl -f -sSL -o "$OUT_TMP" "$FULL_URL" || return 1
    validate_image || return 1
}

download_picsum() {
    # Determine size: prefer WALLPAPER_SIZE env var or detect from sway outputs
    local size="${WALLPAPER_SIZE:-}"
    if [ -z "$size" ]; then
        if command -v niri >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
            local candidate
            candidate=$(niri msg -j outputs 2>/dev/null | jq -r '[.[] | select(.is_current == true)][0] | "\(.current_mode.resolution.width)x\(.current_mode.resolution.height)"' 2>/dev/null || true)
            if [ -n "$candidate" ] && [ "$candidate" != "x" ]; then
                size="$candidate"
            fi
        fi
    fi
    if [ -z "$size" ]; then
        # Ensure default is full HD
        size="1920x1080"
    fi
    # Picsum uses /WIDTH/HEIGHT
    size=${size/x/\/}
    local url="https://picsum.photos/${size}"
    echo "Downloading random image from picsum.photos (${size})..."
    curl -f -L -s -o "$OUT_TMP" "$url" || return 1
    validate_image || return 1
}

download_unsplash() {
    local apikey="$1"
    
    # Randomize query topics for variety
    TOPICS=("minimal,clean" "nature,landscape" "architecture" "abstract,geometric" "space,stars" "dark,moody" "mountains" "ocean,sea" "forest")
    QUERY=${TOPICS[$RANDOM % ${#TOPICS[@]}]}
    
    echo "Fetching random wallpaper from Unsplash (query: $QUERY)..."
    # Use queries that favour clean/minimal photography suitable for wallpapers
    JSON=$(curl -sS -G "https://api.unsplash.com/photos/random" \
        -H "Accept-Version: v1" \
        -H "Authorization: Client-ID $apikey" \
        --data-urlencode "orientation=landscape" \
        --data-urlencode "query=$QUERY" \
        --data-urlencode "content_filter=high" ) || return 1
    # Prefer the raw URL and request a cropped 1920x1080 image via Unsplash URL params
    IMG_RAW=$(echo "$JSON" | jq -r '.urls.raw // .urls.full // .urls.regular')
    if [ -n "$IMG_RAW" ] && [ "$IMG_RAW" != "null" ]; then
        # Append width/height and fit params to ensure full-HD output when supported
        IMG_URL="${IMG_RAW}&w=1920&h=1080&fit=crop&q=80"
    else
        IMG_URL=""
    fi
    if [ -z "$IMG_URL" ] || [ "$IMG_URL" = "null" ]; then
        return 1
    fi
    echo "Downloading image from Unsplash..."
    curl -f -sSL -o "$OUT_TMP" "$IMG_URL" || return 1
    validate_image || return 1
}

main() {
    LOGFILE="$HOME/.local/share/dotfiles/fetch-wallpaper.log"
    mkdir -p "$(dirname "$LOGFILE")"
    logger() { printf "%s %s\n" "$(date --iso-8601=seconds)" "$*" >> "$LOGFILE"; }

    # rotate logs (keep 30)
    if [ -f "$LOGFILE" ] && [ $(wc -c < "$LOGFILE") -gt $((1024*1024*5)) ]; then
        # rotate if >5MB
        mv "$LOGFILE" "$LOGFILE.$(date +%s)" || true
        # keep last 30
        ls -1t "$LOGFILE".* 2>/dev/null | tail -n +31 | xargs -r rm -f
    fi

    logger "fetch-wallpaper: started"

    # 1) Try local directory (only if user explicitly configured one)
    if [ -n "$LIBRARY_DIR" ] && img=$(choose_local); then
        echo "Using local wallpaper: $img"
        cp "$img" "$OUT_TMP"
        logger "Using local wallpaper: $img"
    else
        # remove any stale temp
        rm -f "$OUT_TMP" || true

        # 2) Prefer Unsplash (clean, high-res photos) if API key is present
        src=""
        if [ -f "$UNSPLASH_KEY_FILE" ] && command -v jq >/dev/null 2>&1; then
            KEY=$(tr -d '\n\r ' < "$UNSPLASH_KEY_FILE")
            if [ -n "$KEY" ] && download_unsplash "$KEY"; then
                src="Unsplash"
                logger "Downloaded from Unsplash"
            else
                logger "Unsplash fetch failed; trying other sources"
            fi
        fi

        # 3) Try Wallhaven (anime, digital art, niche) if API key is present
        if [ -z "$src" ] && [ -f "$WALLHAVEN_KEY_FILE" ] && command -v jq >/dev/null 2>&1; then
            KEY=$(tr -d '\n\r ' < "$WALLHAVEN_KEY_FILE")
            if [ -n "$KEY" ] && download_wallhaven "$KEY"; then
                src="Wallhaven"
                logger "Downloaded from Wallhaven"
            else
                logger "Wallhaven fetch failed; trying other sources"
            fi
        fi

        # 4) Try Pexels (photography) if API key is present
        if [ -z "$src" ] && [ -f "$PEXELS_KEY_FILE" ] && command -v jq >/dev/null 2>&1; then
            KEY=$(tr -d '\n\r ' < "$PEXELS_KEY_FILE")
            if [ -n "$KEY" ] && download_pexels "$KEY"; then
                src="Pexels"
                logger "Downloaded from Pexels"
            else
                logger "Pexels fetch failed; trying other sources"
            fi
        fi

        # 5) Try Bing
        if [ -z "$src" ] && command -v jq >/dev/null 2>&1 && download_bing; then
            src="Bing"
            logger "Downloaded from Bing"
        fi

        # 6) Fallback to picsum
        if [ -z "$src" ]; then
            logger "Falling back to Picsum"
            download_picsum && src="Picsum"
        fi

        if [ -z "$src" ]; then
            echo "All wallpaper sources failed." >&2
        else
            echo "Downloaded from $src"
        fi
    fi

    # Ensure a new file was downloaded to the temp location
    if [ ! -s "$OUT_TMP" ]; then
        echo "Download failed or file empty." >&2
        return 1
    fi

    # Archive previous wallpaper (if any) then move the new one into place.
    # Skip archiving when the current daily.jpg hashes identically to the most
    # recent archive entry — that means fetch ran without daily.jpg actually
    # changing (user clicked Fetch twice, source returned the same image, etc.)
    # and re-archiving would just create another duplicate.
    if [ -f "$OUT_FILE" ]; then
        archive_dir="$OUT_DIR/archive"
        mkdir -p "$archive_dir"
        current_hash=$(md5sum -- "$OUT_FILE" | awk '{print $1}')
        latest_archive=$(find "$archive_dir" -maxdepth 1 -type f -name 'daily-*.jpg' -printf '%T@\t%p\n' 2>/dev/null \
            | sort -rn | head -n1 | cut -f2-)
        latest_hash=""
        if [ -n "$latest_archive" ] && [ -f "$latest_archive" ]; then
            latest_hash=$(md5sum -- "$latest_archive" | awk '{print $1}')
        fi
        if [ "$current_hash" != "$latest_hash" ]; then
            ts=$(date +%Y%m%d%H%M%S)
            cp -f "$OUT_FILE" "$archive_dir/daily-$ts.jpg" || true
        else
            logger "skipped archive: current daily.jpg matches latest archive"
        fi
    fi

    mv -f "$OUT_TMP" "$OUT_FILE"
    echo "Wallpaper saved to $OUT_FILE"
    logger "Wallpaper saved to $OUT_FILE"

    # Trigger theme application
    if [ -x "$HOME/.local/bin/set-wallpaper" ]; then
        "$HOME/.local/bin/set-wallpaper" "$OUT_FILE" || true
    else
        echo "set-wallpaper not found; apply-theme not invoked." >&2
    fi

    return 0
}

main "$@"
