#!/usr/bin/env bash
set -euo pipefail

SWAYLOCK_EFFECTS="$(command -v swaylock-effects || true)"
SWAYLOCK="$(command -v swaylock || true)"

SWAYLOCK_CONFIG="$HOME/.config/swaylock/config"

if [ -n "$SWAYLOCK_EFFECTS" ]; then
    if [ -f "$SWAYLOCK_CONFIG" ]; then
        exec "$SWAYLOCK_EFFECTS" --config "$SWAYLOCK_CONFIG"
    else
        exec "$SWAYLOCK_EFFECTS" --blur 7 --indicator --clock
    fi
elif [ -n "$SWAYLOCK" ]; then
    exec "$SWAYLOCK"
else
    echo "No lockscreen binary found (swaylock-effects or swaylock)." >&2
    exit 2
fi
