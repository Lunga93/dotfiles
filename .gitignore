.DS_Store
*.log
*cache*
*.swp
*.bak
*.broken.*
/.idea/
AGENTS.md
CLAUDE.md
.opencode/

# Obsidian session state (regenerated every open)
docs/dev-vault/.obsidian/workspace.json

# Generated by apply-theme / pywal
swaync/.config/swaync/colors.css
wofi/.config/wofi/colors-wal.css
gtk/.config/gtk-3.0/colors-wal.css
gtk/.config/gtk-4.0/colors-wal.css

# Local AGS migration leftover (do not commit)
ags/.config/ags.v1-old/

# Brainstorm sessions (mockup HTML, server state)
.superpowers/

# systemctl --user enable/mask activation symlinks (machine-local state).
# ~/.config/systemd is a symlink into the repo, so `systemctl --user enable`
# creates *.target.wants/ symlinks here, and `systemctl --user mask` creates
# unit-name symlinks pointing to /dev/null.
systemd/.config/systemd/user/*.target.wants/
systemd/.config/systemd/user/mako.service

# wine filesystem artifacts
**/drive_c/
**/dosdevices/
**/*.reg
**/wine-extension-*.desktop

# JetBrains Toolbox auto-generated launchers (machine-local paths/UUIDs)
welcome/.local/share/applications/jetbrains*.desktop
