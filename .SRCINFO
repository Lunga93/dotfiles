pkgbase = manatee-desktop
	pkgdesc = A gentle, glossy Wayland desktop for Arch — Niri compositor, Quickshell bar, pywal theming
	pkgver = 0.1.9
	pkgrel = 1
	url = https://github.com/Lunga93/dotfiles
	install = manatee-desktop.install
	arch = any
	license = MIT
	source = manatee-desktop-0.1.9.tar.gz::https://github.com/Lunga93/dotfiles/archive/refs/tags/v0.1.9.tar.gz
	sha256sums = SKIP

pkgname = manatee-desktop
	depends = niri
	depends = quickshell
	depends = stow
	depends = qt6-declarative
	depends = qt6-svg
	optdepends = python-pywal: Theme engine — generates palettes from wallpapers
	optdepends = python-pillow: Image processing for pywal
	optdepends = swaync: Notification daemon with control center
	optdepends = wofi: Application launcher
	optdepends = alacritty: GPU-accelerated terminal
	optdepends = papirus-icon-theme: Default icon theme
	optdepends = sddm: Login manager — Manatee includes a custom SDDM theme
	optdepends = swaylock: Lock screen
	optdepends = swaylock-effects-git: Enhanced lock screen effects
	optdepends = pipewire: Audio server
	optdepends = wireplumber: PipeWire session manager
	optdepends = networkmanager: Network management
	optdepends = bluez: Bluetooth support
	optdepends = bluez-utils: Bluetooth utilities
	optdepends = cliphist: Clipboard history
	optdepends = wl-clipboard: Wayland clipboard utilities
	optdepends = playerctl: Media player control
	optdepends = pavucontrol: Audio control panel
	optdepends = polkit-kde-agent: Polkit authentication agent
	optdepends = fastfetch: System info on terminal launch
	optdepends = chafa: Image-to-terminal for fastfetch
	optdepends = curl: HTTP client for wallpaper fetching
	optdepends = jq: JSON processor for scripts
	optdepends = wlsunset: Night light / blue light filter
	optdepends = ttf-fira-sans: Bar + UI font
	optdepends = ttf-roboto: Fallback font
	optdepends = otf-font-awesome: Icon glyphs for bar
	optdepends = ntfs-3g: NTFS drive support
	optdepends = aylurs-gtk-shell: Legacy AGS shell (archived)
	optdepends = overskride: Bluetooth device manager
	optdepends = awww: Animated wallpaper daemon
	optdepends = ttf-phosphor-icons: Phosphor icon font
	optdepends = xwayland-satellite: XWayland rootful support
	optdepends = zen-browser-bin: Zen browser
	optdepends = gnome-calendar: Calendar application
	optdepends = nautilus: File manager
	optdepends = bats-core: Bash test framework
	optdepends = shellcheck: Shell script linter
	optdepends = shfmt: Shell script formatter
	optdepends = opencode: AI coding agent
