QMenu {
    background-color: #100a0d;
    color: #a5b9ad;
    border: 1px solid #1b5510;
    padding: 4px;
    border-radius: 8px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #57914C;
    color: #100a0d;
}

QMenu::separator {
    height: 1px;
    background-color: #1b5510;
    margin: 4px 12px;
}
