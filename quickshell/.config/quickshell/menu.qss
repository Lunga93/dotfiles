QMenu {
    background-color: #092132;
    color: #becdde;
    border: 1px solid #014583;
    padding: 4px;
    border-radius: 8px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3D81BF;
    color: #092132;
}

QMenu::separator {
    height: 1px;
    background-color: #014583;
    margin: 4px 12px;
}
