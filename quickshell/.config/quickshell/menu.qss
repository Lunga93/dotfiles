QMenu {
    background-color: #020000;
    color: #f27e7e;
    border: 1px solid #920000;
    padding: 4px;
    border-radius: 8px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #CE0202;
    color: #020000;
}

QMenu::separator {
    height: 1px;
    background-color: #920000;
    margin: 4px 12px;
}
